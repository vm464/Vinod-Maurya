<script>
const bookingId = {{ booking_id }};
const isVideo = {{ 'true' if mode=='video' else 'false' }};
const signalUrl = "{{ url_for('call_signal', booking_id=booking_id) }}";
const pollUrl = "{{ url_for('call_poll', booking_id=booking_id) }}";
const myId = {{ current_user['id'] }};

let pc, localStream, lastSignalId = 0, madeOffer = false, hasRemote = false;
const statusBadge = document.getElementById('call-status');

const config = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };
// TODO PRODUCTION: add a TURN server here as a relay fallback for networks that block
// direct peer connections, e.g. { urls: 'turn:your-turn-server', username: '...', credential: '...' }

async function setStatus(text, cls){
  statusBadge.textContent = text;
  statusBadge.className = 'badge bg-' + (cls || 'secondary');
}

async function sendSignal(type, payload){
  await fetch(signalUrl, {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({type, payload})
  });
}

async function pollSignals(){
  try{
    const r = await fetch(pollUrl + '?after=' + lastSignalId);
    const data = await r.json();
    for(const sig of data.signals){
      lastSignalId = Math.max(lastSignalId, sig.id);
      if(sig.type === 'offer' && !hasRemote){
        hasRemote = true;
        await pc.setRemoteDescription(new RTCSessionDescription(sig.payload));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        await sendSignal('answer', answer);
        setStatus('Connecting...', 'warning');
      } else if(sig.type === 'answer' && madeOffer && !hasRemote){
        hasRemote = true;
        await pc.setRemoteDescription(new RTCSessionDescription(sig.payload));
        setStatus('Connecting...', 'warning');
      } else if(sig.type === 'candidate'){
        try{ await pc.addIceCandidate(new RTCIceCandidate(sig.payload)); }catch(e){}
      } else if(sig.type === 'hangup'){
        setStatus('Call ended by other party', 'danger');
        cleanup();
      }
    }
  }catch(e){ /* transient network hiccup, next poll will retry */ }
}

async function startCall(){
  try{
    localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: isVideo });
  }catch(e){
    setStatus('Camera/Mic permission denied', 'danger');
    return;
  }
  document.getElementById('localVideo').srcObject = localStream;

  pc = new RTCPeerConnection(config);
  localStream.getTracks().forEach(t => pc.addTrack(t, localStream));

  pc.ontrack = (e) => {
    document.getElementById('remoteVideo').srcObject = e.streams[0];
    setStatus('Connected', 'success');
  };
  pc.onicecandidate = (e) => { if(e.candidate) sendSignal('candidate', e.candidate); };
  pc.onconnectionstatechange = () => {
    if(pc.connectionState === 'connected') setStatus('Connected', 'success');
    if(['disconnected','failed','closed'].includes(pc.connectionState)) setStatus('Call ended', 'secondary');
  };

  setStatus('Waiting for the other party...', 'warning');
  setInterval(pollSignals, 1500);

  // Whoever's tab has been open slightly longer becomes the caller; the other
  // side will see the incoming 'offer' on its next poll and auto-answer.
  setTimeout(async () => {
    if(!hasRemote){
      madeOffer = true;
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      await sendSignal('offer', offer);
    }
  }, 800);
}

function cleanup(){
  if(localStream) localStream.getTracks().forEach(t => t.stop());
  if(pc) pc.close();
}

