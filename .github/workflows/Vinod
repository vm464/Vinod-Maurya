def create_booking(patient_id, booking_type, provider_id, reference_id, item_name, amount, scheduled_time="", address="", notes=""):
    db = get_db()
    cur = db.execute(
        "INSERT INTO bookings (patient_id, booking_type, provider_id, reference_id, item_name, amount, scheduled_time, address, notes) "
        "VALUES (?,?,?,?,?,?,?,?,?)",
        (patient_id, booking_type, provider_id, reference_id, item_name, amount, scheduled_time, address, notes),
    )
    db.commit()
    return cur.lastrowid


