  await sendSignal('hangup', {});
  cleanup();
  setStatus('Call ended', 'secondary');
  setTimeout(() => { window.location.href = "{{ url_for('dashboard') }}"; }, 800);
});

window.addEventListener('beforeunload', () => { sendSignal('hangup', {}); cleanup(); });

startCall();
</script>
{% endblock %}
