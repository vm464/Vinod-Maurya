@app.route("/pay/<int:booking_id>", methods=["GET", "POST"])
@role_required("patient")
def pay(booking_id):
    db = get_db()
    booking = db.execute("SELECT * FROM bookings WHERE id=? AND patient_id=?", (booking_id, current_user()["id"])).fetchone()
    if not booking:
        abort(404)
    if booking["payment_status"] == "paid":
        flash("This booking is already paid.", "info")
        return redirect(url_for("dashboard"))

    total = float(booking["amount"])
    platform_fee = round(total * PLATFORM_COMMISSION_RATE, 2)
    provider_amount = round(total - platform_fee, 2)

    if request.method == "POST":
        # TODO PRODUCTION: Replace this entire block with a real gateway, e.g.:
        #   Razorpay: razorpay_client.order.create({...}); verify webhook signature on success.
        #   Stripe:   stripe.checkout.Session.create(...); verify via webhook.
        method = request.form.get("method", "UPI")
        txn_id = "TXN" + secrets.token_hex(6).upper()
        db.execute(
            "INSERT INTO payments (booking_id, amount, platform_fee, provider_amount, method, transaction_id) VALUES (?,?,?,?,?,?)",
            (booking_id, total, platform_fee, provider_amount, method, txn_id)
        )
        db.execute("UPDATE bookings SET payment_status='paid', status='confirmed' WHERE id=?", (booking_id,))
        db.commit()
        award_points(booking["patient_id"],100,"purchase",booking_id,booking_id)
        notify(booking["patient_id"], f"Payment of Rs.{total:.2f} successful (Txn: {txn_id}). Your {booking['booking_type']} booking is confirmed!")
        notify(booking["provider_id"], f"New confirmed {booking['booking_type']} booking: '{booking['item_name']}' "
                                         f"- total Rs.{total:.2f}; your settlement after MediConnect's "
                                         f"{int(PLATFORM_COMMISSION_RATE*100)}% platform fee is Rs.{provider_amount:.2f}.")
        log_action(current_user()["id"], "payment_success", f"booking={booking_id} txn={txn_id}")
        flash("Payment successful! Your booking is confirmed.", "success")
        return redirect(url_for("dashboard"))

    body = f"""<div class="card p-4 text-center">
