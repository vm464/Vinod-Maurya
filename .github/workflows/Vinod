@app.route("/pharmacy/order", methods=["POST"])
@role_required("patient")
def add_medicine_order():
    db = get_db()
    pid = current_user()["id"]
    product_id = int(request.form["product_id"])
    qty = max(1, int(request.form.get("quantity", 1)))

    p = db.execute(
        """SELECT pp.*, u.is_approved seller_approved
           FROM pharmacy_products pp
           LEFT JOIN users u ON u.id=pp.seller_id
           WHERE pp.id=? AND pp.is_active=1""",
        (product_id,)
    ).fetchone()

    if not p or p["stock"] < qty:
        flash("Medicine is unavailable in the requested quantity.", "danger")
        return redirect(url_for("pharmacy"))

    if p["seller_id"] and not p["seller_approved"]:
        flash("This medical store has not been approved yet.", "danger")
        return redirect(url_for("pharmacy"))

    if p["prescription_required"]:
        rx = db.execute(
            "SELECT id FROM prescriptions WHERE patient_id=? ORDER BY id DESC LIMIT 1",
            (pid,)
        ).fetchone()
        if not rx:
            flash("This medicine requires a prescription. Please add a prescription to your medical records first.", "warning")
            return redirect(url_for("medical_records"))

    total = p["price"] * qty
    cur = db.execute(
        "INSERT INTO medicine_orders (patient_id,seller_id,total_amount,status,delivery_address) "
        "VALUES (?,?,?,?,?)",
        (pid, p["seller_id"], total, "placed", "")
    )
    oid = cur.lastrowid
    db.execute(
        "INSERT INTO medicine_order_items (order_id,product_id,quantity,unit_price) VALUES (?,?,?,?)",
        (oid, p["id"], qty, p["price"])
    )
    db.execute("UPDATE pharmacy_products SET stock=stock-? WHERE id=?", (qty, p["id"]))
    db.commit()

    award_points(pid, 100, "purchase", f"medicine-{oid}", f"medicine-{oid}")
    notify(pid, f"Medicine order #{oid} placed for ₹{total:.2f}. You earned 100 points!")

    if p["seller_id"]:
        notify(p["seller_id"], f"New medicine order #{oid} received for ₹{total:.2f}. Please process the order.")

    return redirect(url_for("medicine_orders"))


