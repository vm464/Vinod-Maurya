@app.route("/quick-consultation", methods=["POST"])
def quick_consultation():
    """Start the homepage consultation flow safely.

    The homepage form collects patient details but does not itself create a booking.
    We keep the details in the session, make sure the visitor is a Patient, and then
    send them to the verified-doctor selection page. This prevents the old 403 issue
    caused by opening /book/doctor/<id> as a non-patient account.
    """
    patient_name = request.form.get("patient_name", "").strip()
    mobile = request.form.get("mobile", "").strip()
    department = request.form.get("department", "").strip()

    if not patient_name or not valid_mobile(mobile) or not department:
        flash("Please enter a valid patient name, 10-digit mobile number and department.", "danger")
        return redirect(url_for("home"))

    session["pending_consultation"] = {
        "patient_name": patient_name,
        "mobile": mobile,
        "department": department,
    }

    u = current_user()
    if not u:
        flash("Please log in with a Patient account to choose a doctor and complete your consultation booking.", "info")
        return redirect(url_for("login"))

    if u["role"] != "patient":
        flash("Doctor selection and consultation booking are available only from a Patient account. Please log in with your Patient account.", "warning")
        return redirect(url_for("list_doctors", department=department))

    return redirect(url_for("list_doctors", department=department))


