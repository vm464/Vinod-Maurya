@app.route("/pharmacy/products/add", methods=["POST"])
@role_required("pharmacy")
def add_pharmacy_product():
    db = get_db()
    u = current_user()

    if not u["is_approved"]:
        flash("Your medical store must be approved by Admin before you can publish medicines.", "warning")
        return redirect(url_for("dashboard"))

    prof = db.execute(
        "SELECT store_name FROM pharmacy_profiles WHERE user_id=?",
        (u["id"],)
    ).fetchone()
    if not prof:
        abort(404)

    medicine_name = request.form.get("medicine_name", "").strip()
    category = request.form.get("category", "").strip()
    price = float(request.form.get("price") or 0)
    stock = max(0, int(request.form.get("stock") or 0))
    prescription_required = 1 if request.form.get("prescription_required") == "1" else 0

    if not medicine_name or price <= 0:
        flash("Medicine name and a valid selling price are required.", "danger")
        return redirect(url_for("dashboard"))

    db.execute(
        """INSERT INTO pharmacy_products
           (seller_id,seller_name,medicine_name,category,price,stock,prescription_required)
           VALUES (?,?,?,?,?,?,?)""",
        (u["id"], prof["store_name"], medicine_name, category, price, stock, prescription_required)
    )
    db.commit()
    log_action(u["id"], "add_pharmacy_product", f"medicine={medicine_name}")
    flash("Medicine added to your online store.", "success")
    return redirect(url_for("dashboard"))


