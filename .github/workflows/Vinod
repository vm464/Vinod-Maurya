      <div class="d-flex justify-content-between"><span>MediConnect platform reserve ({int(PLATFORM_COMMISSION_RATE*100)}%)</span><b>Rs. {platform_fee:.2f}</b></div>
      <div class="d-flex justify-content-between"><span>Provider receives</span><b>Rs. {provider_amount:.2f}</b></div>
