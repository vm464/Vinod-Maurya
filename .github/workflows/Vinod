def ensure_gamification_profile(user_id):
    db=get_db(); db.execute("INSERT OR IGNORE INTO gamification_profiles (user_id) VALUES (?)",(user_id,)); db.commit()

def award_points(user_id, points, action, reference_id=None, unique_key=None):
    db=get_db(); ensure_gamification_profile(user_id)
    if unique_key is not None and db.execute("SELECT id FROM points_transactions WHERE user_id=? AND action=? AND reference_id=?",(user_id,action,str(unique_key))).fetchone(): return False
    db.execute("INSERT INTO points_transactions (user_id,points,action,reference_id) VALUES (?,?,?,?)",(user_id,points,action,str(reference_id) if reference_id is not None else None)); db.execute("UPDATE gamification_profiles SET points=points+? WHERE user_id=?",(points,user_id)); db.commit(); return True

def award_daily_login(user_id):
    db=get_db(); ensure_gamification_profile(user_id); today=datetime.now().strftime("%Y-%m-%d"); p=db.execute("SELECT * FROM gamification_profiles WHERE user_id=?",(user_id,)).fetchone()
    if p["last_login_date"]==today: return False
    yesterday=(datetime.now()-timedelta(days=1)).strftime("%Y-%m-%d"); streak=p["streak"]+1 if p["last_login_date"]==yesterday else 1
    db.execute("UPDATE gamification_profiles SET last_login_date=?,streak=? WHERE user_id=?",(today,streak,user_id)); db.commit(); return award_points(user_id,5,"daily_login",today,today)

def user_gamification(user_id):
    db=get_db(); ensure_gamification_profile(user_id); p=db.execute("SELECT * FROM gamification_profiles WHERE user_id=?",(user_id,)).fetchone(); points=p["points"]; streak=p["streak"]
    badges=[]
    if points>=100: badges.append("First Steps")
    if points>=500: badges.append("Health Explorer")
    if points>=1000: badges.append("MediConnect Pro")
    if streak>=3: badges.append("3-Day Streak")
    if streak>=7: badges.append("7-Day Streak")
    if streak>=30: badges.append("30-Day Champion")
    return {"points":points,"streak":streak,"level":points//500+1,"badges":badges}

def referral_code_for(user_id):
    db=get_db(); r=db.execute("SELECT referral_code FROM users WHERE id=?",(user_id,)).fetchone()
    if r and r["referral_code"]: return r["referral_code"]
    code="MC"+secrets.token_hex(4).upper(); db.execute("UPDATE users SET referral_code=? WHERE id=?",(code,user_id)); db.commit(); return code

