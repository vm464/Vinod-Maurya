    if role not in ROLES or role == "admin":
        flash("Invalid role selected.", "danger")
        return redirect(url_for("register"))
    if not name or not valid_mobile(mobile) or not valid_email(email) or len(password) < 6:
        flash("Please fill all fields correctly. Mobile must be a valid 10-digit Indian number.", "danger")
        return redirect(url_for("register"))

    dup = db.execute("SELECT id FROM users WHERE mobile=? OR email=?", (mobile, email)).fetchone()
    if dup:
        flash("An account with this mobile or email already exists.", "danger")
