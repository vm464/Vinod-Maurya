AI_SYSTEM_PROMPT = """You are MediConnect AI, the virtual health information assistant for the
MediConnect India website. Give clear, concise, empathetic health-information answers.
You may explain symptoms, common causes, prevention, general medicines information,
healthcare services, and when to seek medical care. Do NOT diagnose with certainty,
do NOT prescribe or change prescription medicines, and do NOT claim to be a doctor.
For emergencies (such as severe chest pain, severe breathing difficulty, unconsciousness,
stroke symptoms, uncontrolled bleeding, or other life-threatening symptoms), tell the user
to seek emergency medical care immediately and use local emergency services.
Encourage a qualified doctor for diagnosis and personalized treatment. Never request
passwords, OTPs, card numbers, or other secrets. Keep answers suitable for a general
Indian audience. If the user asks about MediConnect services, explain that the website
can help them find doctors, hospitals, lab tests, medicines, and emergency services,
but do not invent provider availability, prices, or appointments."""


def _extract_openai_text(data):
    """Extract text from a Responses API JSON response without requiring an SDK."""
    if isinstance(data, dict):
        if isinstance(data.get("output_text"), str) and data["output_text"].strip():
            return data["output_text"].strip()
        parts = []
        for item in data.get("output", []) or []:
            if isinstance(item, dict):
                for content in item.get("content", []) or []:
                    if isinstance(content, dict) and content.get("type") in {"output_text", "text"}:
                        text = content.get("text")
                        if isinstance(text, str) and text.strip():
                            parts.append(text.strip())
        if parts:
            return "\n".join(parts)
    return ""


@app.route("/api/ai-assistant", methods=["POST"])
def ai_assistant():
    """Public AI chat endpoint used by the homepage floating assistant."""
    payload = request.get_json(silent=True) or {}
    messages = payload.get("messages", [])
    if not isinstance(messages, list):
        messages = []

    clean = []
    for m in messages[-12:]:
        if not isinstance(m, dict):
            continue
        role = m.get("role")
        content = m.get("content")
        if role in {"user", "assistant"} and isinstance(content, str) and content.strip():
            clean.append({"role": role, "content": content.strip()[:4000]})

    if not clean or clean[-1]["role"] != "user":
        return jsonify({"ok": False, "error": "Please enter a question."}), 400

    if not OPENAI_API_KEY:
        return jsonify({
            "ok": False,
            "error": "AI assistant is not connected yet. Set the OPENAI_API_KEY environment variable and restart MediConnect."
        }), 503

    # Responses API accepts a string or structured input. A compact transcript keeps
    # the public widget predictable and limits accidental context growth.
    transcript = "\n".join(f"{m['role'].upper()}: {m['content']}" for m in clean)
    body = {
        "model": OPENAI_AI_MODEL,
        "input": AI_SYSTEM_PROMPT + "\n\nConversation:\n" + transcript,
    }

    req = urllib.request.Request(
        "https://api.openai.com/v1/responses",
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {OPENAI_API_KEY}",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=45) as response:
            data = json.loads(response.read().decode("utf-8"))
        answer = _extract_openai_text(data)
        if not answer:
            return jsonify({"ok": False, "error": "The AI returned an empty response. Please try again."}), 502
        return jsonify({"ok": True, "answer": answer})
    except urllib.error.HTTPError as exc:
        try:
            detail = exc.read().decode("utf-8")[:500]
        except Exception:
            detail = ""
        app.logger.warning("AI assistant HTTP error %s: %s", exc.code, detail)
        return jsonify({"ok": False, "error": "The AI service could not answer right now. Please try again."}), 502
    except Exception:
        app.logger.exception("AI assistant request failed")
        return jsonify({"ok": False, "error": "The AI service is temporarily unavailable. Please try again."}), 502


