@app.route("/verify-otp", methods=["GET", "POST"])
def verify_otp():
    user_id = session.get("pending_user_id")
    if not user_id:
        flash("Session expired. Please log in or register again.", "warning")
        return redirect(url_for("login"))

    if request.method == "GET":
        return render("verify_otp.html")

    db = get_db()
    entered = request.form.get("otp", "").strip()
    row = db.execute(
        "SELECT * FROM otp_codes WHERE user_id=? AND used=0 ORDER BY id DESC LIMIT 1", (user_id,)
    ).fetchone()

    if not row or row["code"] != entered:
        flash("Incorrect OTP. Please try again.", "danger")
        return redirect(url_for("verify_otp"))
    if datetime.fromisoformat(row["expires_at"]) < datetime.utcnow():
        flash("OTP expired. Please request a new one.", "danger")
        return redirect(url_for("verify_otp"))

    db.execute("UPDATE otp_codes SET used=1 WHERE id=?", (row["id"],))
    db.execute("UPDATE users SET mobile_verified=1 WHERE id=?", (user_id,))
    user = db.execute("SELECT * FROM users WHERE id=?", (user_id,)).fetchone()
    # Patients are auto-approved; providers need admin document verification.
    if user["role"] == "patient":
        db.execute("UPDATE users SET is_approved=1 WHERE id=?", (user_id,))
    db.commit()

    session.pop("pending_user_id", None)
    session["user_id"] = user_id
    award_daily_login(user_id)
    if user["referred_by"]:
        if award_points(user["referred_by"],200,"referral",user_id,user_id): notify(user["referred_by"],f"You earned 200 points because {user['name']} joined using your referral code!")
    notify(user_id, "Welcome to MediConnect! Your mobile number is verified.")
    log_action(user_id, "otp_verified")
    if not user["profile_photo"]:
        flash("Mobile verified. Please add your compulsory profile photo.", "warning")
        return redirect(url_for("profile_photo"))
    flash("Verified successfully! Welcome to MediConnect.", "success")
    return redirect(url_for("dashboard"))


