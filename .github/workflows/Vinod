/* ===== FINAL PROFILE DROPDOWN POSITION FIX =====
   Bootstrap can position a dropdown inside a stacking context created by
   dashboard/hero sections. We position this menu against the viewport. */
(function () {
  function setupProfileMenu() {
    const toggle = document.querySelector('.navbar .navbar-profile');
    const menu = document.querySelector('.navbar .profile-menu');
    if (!toggle || !menu) return;

    function placeMenu() {
      if (!menu.classList.contains('show')) return;

      const r = toggle.getBoundingClientRect();
      const gap = 8;
      const margin = 8;
      const vw = window.innerWidth;
      const vh = window.innerHeight;

      // Make it visible before measuring its real height.
      menu.style.position = 'fixed';
      menu.style.transform = 'none';
      menu.style.zIndex = '2147483647';
      menu.style.visibility = 'hidden';
      menu.style.display = 'block';

      const mw = Math.min(menu.offsetWidth || 255, vw - margin * 2);
      const mh = menu.offsetHeight || 300;

      let left = r.right - mw;
      left = Math.max(margin, Math.min(left, vw - mw - margin));

      // Prefer below the profile button, but move above it if there isn't room.
      let top = r.bottom + gap;
      if (top + mh > vh - margin) {
        top = r.top - mh - gap;
      }
      top = Math.max(margin, Math.min(top, vh - mh - margin));

      menu.style.left = Math.round(left) + 'px';
      menu.style.top = Math.round(top) + 'px';
      menu.style.right = 'auto';
      menu.style.bottom = 'auto';
      menu.style.visibility = 'visible';
    }

    toggle.addEventListener('shown.bs.dropdown', function () {
      requestAnimationFrame(placeMenu);
      setTimeout(placeMenu, 50);
    });

    toggle.addEventListener('hidden.bs.dropdown', function () {
      menu.style.removeProperty('position');
      menu.style.removeProperty('left');
      menu.style.removeProperty('top');
      menu.style.removeProperty('right');
      menu.style.removeProperty('bottom');
      menu.style.removeProperty('z-index');
      menu.style.removeProperty('visibility');
      menu.style.removeProperty('display');
    });

    window.addEventListener('resize', placeMenu);
    window.addEventListener('scroll', placeMenu, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProfileMenu);
  } else {
    setupProfileMenu();
  }
})();
</script>

</body>
