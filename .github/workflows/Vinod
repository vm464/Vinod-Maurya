@app.route("/pharmacy/orders/<int:order_id>/status", methods=["POST"])
@role_required("pharmacy")
def update_pharmacy_order_status(order_id):
    db = get_db()
    status = request.form.get("status", "placed")
    allowed = {"placed", "confirmed", "packed", "shipped", "out_for_delivery", "delivered", "cancelled"}
    if status not in allowed:
        abort(400)

    order = db.execute(
        "SELECT * FROM medicine_orders WHERE id=? AND seller_id=?",
        (order_id, current_user()["id"])
    ).fetchone()
    if not order:
        abort(404)

    db.execute("UPDATE medicine_orders SET status=? WHERE id=?", (status, order_id))
    db.commit()

    patient_messages = {
        "confirmed": f"Medicine order #{order_id} has been confirmed by the medical store.",
        "packed": f"Medicine order #{order_id} has been packed.",
        "shipped": f"Medicine order #{order_id} has been shipped.",
        "out_for_delivery": f"Medicine order #{order_id} is out for delivery.",
        "delivered": f"Medicine order #{order_id} has been delivered.",
        "cancelled": f"Medicine order #{order_id} was cancelled by the medical store.",
    }
    notify(order["patient_id"], patient_messages.get(status, f"Medicine order #{order_id} status updated to {status}."))
    log_action(current_user()["id"], "update_pharmacy_order_status", f"order={order_id} -> {status}")
    flash("Medicine order status updated.", "success")
    return redirect(url_for("pharmacy_orders"))


