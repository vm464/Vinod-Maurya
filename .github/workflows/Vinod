@app.route("/login", methods=["GET", "POST"])
def login():
    if request.method == "GET":
        return render("login.html")
    db = get_db()
    mobile = request.form.get("mobile", "").strip()
    password = request.form.get("password", "")
    user = db.execute("SELECT * FROM users WHERE mobile=?", (mobile,)).fetchone()
    if user and user["role"] == "admin":
        flash("Administrators must use the separate 'Login as an Admin' page.", "warning")
        return redirect(url_for("admin_login"))
    if not user or not check_password_hash(user["password_hash"], password):
        flash("Invalid mobile number or password.", "danger")
        return redirect(url_for("login"))
    if not user["is_active"]:
        flash("This account has been deactivated. Contact support.", "danger")
        return redirect(url_for("login"))
    if not user["mobile_verified"]:
        session["pending_user_id"] = user["id"]
        code = gen_otp()
        expires = (datetime.utcnow() + timedelta(minutes=10)).isoformat()
        db.execute("INSERT INTO otp_codes (user_id, code, purpose, expires_at) VALUES (?,?,?,?)",
                   (user["id"], code, "login", expires))
        db.commit()
        send_otp(user, code, "login verification")
        flash("Please verify OTP to continue.", "info")
        return redirect(url_for("verify_otp"))

    session["user_id"] = user["id"]
    award_daily_login(user["id"])
    log_action(user["id"], "login")
    if not user["profile_photo"]:
        flash("Please add your compulsory profile photo to continue.", "warning")
        return redirect(url_for("profile_photo"))
    flash(f"Welcome back, {user['name']}!", "success")
    pending = session.get("pending_consultation")
    if pending and user["role"] == "patient":
        return redirect(url_for("list_doctors", department=pending.get("department", "")))
    return redirect(url_for("dashboard"))


