def _get_call_booking_or_404(booking_id):
    """A call is only allowed on a paid 'doctor' booking, and only by the two
    people involved: that booking's patient and that booking's doctor."""
    db = get_db()
    u = current_user()
    booking = db.execute(
        "SELECT * FROM bookings WHERE id=? AND booking_type='doctor' AND payment_status='paid'",
        (booking_id,)
    ).fetchone()
    if not booking or u["id"] not in (booking["patient_id"], booking["provider_id"]):
        abort(404)
    return booking


@app.route("/call/<int:booking_id>")
@login_required
def call_room(booking_id):
    booking = _get_call_booking_or_404(booking_id)
    db = get_db()
    u = current_user()
    mode = request.args.get("mode", "video")
    if mode not in ("video", "audio"):
        mode = "video"
    if u["id"] == booking["patient_id"]:
        other = db.execute("SELECT name FROM users WHERE id=?", (booking["provider_id"],)).fetchone()
        other_label = f"Dr. {other['name']}" if other else "Doctor"
    else:
        other = db.execute("SELECT name FROM users WHERE id=?", (booking["patient_id"],)).fetchone()
        other_label = other["name"] if other else "Patient"
    return render("call_room.html", booking_id=booking_id, mode=mode, other_party_label=other_label)


@app.route("/call/<int:booking_id>/signal", methods=["POST"])
@login_required
def call_signal(booking_id):
    booking = _get_call_booking_or_404(booking_id)
    data = request.get_json(silent=True) or {}
    signal_type = data.get("type")
    payload = data.get("payload")
    if signal_type not in ("offer", "answer", "candidate", "hangup"):
        return jsonify({"ok": False, "error": "invalid signal type"}), 400
    db = get_db()
    db.execute(
        "INSERT INTO call_signals (booking_id, sender_id, signal_type, payload) VALUES (?,?,?,?)",
        (booking_id, current_user()["id"], signal_type, json.dumps(payload)),
    )
    db.commit()
    if signal_type == "offer":
        # Let the other party know a call is coming in even if their tab isn't open yet.
        other_id = booking["provider_id"] if current_user()["id"] == booking["patient_id"] else booking["patient_id"]
        notify(other_id, f"Incoming call for your booking '{booking['item_name']}'. Open your dashboard to join.")
    return jsonify({"ok": True})


@app.route("/call/<int:booking_id>/poll")
@login_required
def call_poll(booking_id):
    _get_call_booking_or_404(booking_id)
    after = request.args.get("after", 0, type=int)
    db = get_db()
    # Only return signals sent by the OTHER participant, so a browser never echoes
    # its own offer/candidates back to itself.
    rows = db.execute(
        "SELECT id, signal_type, payload FROM call_signals "
        "WHERE booking_id=? AND sender_id!=? AND id>? ORDER BY id ASC",
        (booking_id, current_user()["id"], after),
    ).fetchall()
    signals = [{"id": r["id"], "type": r["signal_type"], "payload": json.loads(r["payload"])} for r in rows]
    return jsonify({"signals": signals})


